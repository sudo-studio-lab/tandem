{
  "name": "tandem-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @tandem/web && npm run build -w @tandem/cli",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tandem": "node apps/cli/dist/bin.js",
    "test:agents": "npm run build -w @tandem/cli && vitest run -c vitest.agents.config.ts",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "dugite@3.3.2": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
